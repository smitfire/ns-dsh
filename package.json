{
  "name": "@smitfire/ns-dsh",
  "version": "0.1.0",
  "description": "Modular plugin distribution for DeepSeek Harness integrating Forewisp context, Code Mode FTS5, CUGA governance, HITL Kanban DAG, and Switchyard+OCR agent teams",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smitfire/ns-dsh.git"
  },
  "main": "./dist/telemetry/flight-recorder.js",
  "types": "./dist/telemetry/flight-recorder.d.ts",
  "bin": {
    "ns-dsh": "./bin/ns-dsh.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/telemetry/flight-recorder.d.ts",
      "default": "./dist/telemetry/flight-recorder.js"
    },
    "./canary": {
      "types": "./dist/upgrade/canary.d.ts",
      "default": "./dist/upgrade/canary.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "bin",
    "bench",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.3 <0.3.0-0",
    "node": ">=24.0.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x bin/ns-dsh.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test test/*.test.ts"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-agent": ">=0.2.2-rc.3 <0.3.0-0",
    "@deepseek-ai/dsh-session": ">=0.2.2-rc.3 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.3 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh": "0.2.2-rc.3",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.3",
    "@deepseek-ai/dsh-agent-loop": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-store": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-agent-team": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.3",
    "@deepseek-ai/dsh-commands": "0.2.2-rc.3",
    "@deepseek-ai/dsh-host-webserver": "0.2.2-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.3",
    "@deepseek-ai/dsh-session": "0.2.2-rc.3",
    "@deepseek-ai/dsh-subagent": "0.2.2-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.3",
    "@deepseek-ai/dsh-tool-executor-ptc": "0.2.2-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.3",
    "@deepseek-ai/dsh-user-approval": "0.2.2-rc.3",
    "@deepseek-ai/schemastery": "3.19.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "dsh-antigravity-auth": "0.1.10",
    "react": "^18.3.1",
    "typescript": "^5.9.0"
  }
}
